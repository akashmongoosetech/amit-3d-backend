PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/verto3d_admin
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Admin signup gate (C1): keep false in production; set a strong key for bootstrapping
ALLOW_PUBLIC_SIGNUP=false
ADMIN_SETUP_KEY=change-me-to-a-long-random-string
# Email (Zoho SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Dev-only: log OTP events without exposing OTP values
LOG_OTP_IN_CONSOLE=false
